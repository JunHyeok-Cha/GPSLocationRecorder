<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context="com.example.gpslocationrecorder.MainMenuSettingFragment">

    <TextView
        android:id="@+id/text_setting_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="설정"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_setting_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="주차 감지 및 기록"
                android:textColor="#555555"
                android:textSize="14sp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_auto_record"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="자동 주차 위치 기록"
                android:textSize="18sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="알림"
                android:textColor="#555555"
                android:textSize="14sp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_record_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="주차 기록 완료 시 알림"
                android:textSize="18sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"/>

            <!-- ★ [추가] 개발자 테스트용 섹션 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="개발자 테스트"
                android:textColor="#FF5722"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_simulate_bluetooth_disconnect"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="블루투스 끊김 시뮬레이션"
                app:strokeColor="#FF5722"
                android:textColor="#FF5722" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>