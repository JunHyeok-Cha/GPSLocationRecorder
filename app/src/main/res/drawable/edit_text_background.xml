<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 배경 색상: 옅은 회색 -->
    <solid android:color="#F0F0F0" />

    <!-- 모서리를 둥글게 (8dp) -->
    <corners android:radius="8dp" />

    <!-- 안쪽 여백 -->
    <padding
        android:left="12dp"
        android:top="10dp"
        android:right="12dp"
        android:bottom="10dp" />

</shape>